# --- Local development (docker compose) ---
# Run: docker compose up -d
DATABASE_URL=postgresql://wifi:wifi123@localhost:5433/wifi_voucher
DIRECT_URL=postgresql://wifi:wifi123@localhost:5433/wifi_voucher

# --- Supabase (production) ---
# If password contains @, encode each @ as %40
# Example password Anondo554@@ becomes Anondo554%40%40
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
PORT=3001
# Comma-separated exact frontend origins for production, for example:
# CORS_ORIGIN=https://your-frontend.example.com,https://www.your-frontend.example.com
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required only when running prisma/seed.ts to create an admin account.
# Use a unique password and phone number; do not use sample/default credentials.
# ADMIN_EMAIL=admin@your-domain.example
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_PHONE=
