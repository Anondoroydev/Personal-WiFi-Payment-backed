generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())

  payments         PaymentRequest[]
  assignedVouchers Voucher[]        @relation("AssignedVouchers")
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  sentAt    DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Package {
  id        String      @id @default(cuid())
  name      String      @unique
  duration  Int
  price     Int
  type      String
  createdAt DateTime    @default(now())

  vouchers Voucher[]
  payments PaymentRequest[]
}

model Voucher {
  id             String        @id @default(cuid())
  username       String
  password       String
  packageId      String
  status         String        @default("AVAILABLE")
  assignedUserId String?
  usedAt         DateTime?
  createdAt      DateTime      @default(now())

  package      Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assignedUser User?   @relation("AssignedVouchers", fields: [assignedUserId], references: [id], onDelete: SetNull)

  payment PaymentRequest?

  @@unique([username, packageId])
  @@index([packageId, status])
}

model PaymentRequest {
  id              String        @id @default(cuid())
  userId          String
  packageId       String
  amount          Int
  paymentMethod   String
  transactionId   String
  status          String        @default("PENDING")
  voucherId       String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package  @relation(fields: [packageId], references: [id])
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
